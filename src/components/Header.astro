---
import { t, localePath, type Lang } from '@/lib/i18n';
import type { NavKey } from '@/layouts/BaseLayout.astro';

interface Props {
  lang: Lang;
  nav: NavKey;
  altPath: string;
}
const { lang, nav, altPath } = Astro.props;
const d = t(lang);

const items: { key: NavKey; icon: string; path: string }[] = [
  { key: 'home', icon: 'fa-home', path: '/' },
  { key: 'news', icon: 'fa-info', path: '/news/' },
  { key: 'introduction', icon: 'fa-bar-chart', path: '/introduction/' },
  { key: 'members', icon: 'fa-user', path: '/members/' },
  { key: 'publications', icon: 'fa-file-text', path: '/publications/' },
  { key: 'access', icon: 'fa-map-marker', path: '/access/' },
  { key: 'links', icon: 'fa-link', path: '/links/' },
];
const langs: Lang[] = ['ja', 'en'];
---

<header class="site-header">
  <div class="site-w site-header__inner">
    <div class="site-header__left">
      <h1 class="site-title"><a href={localePath(lang, '/')}>{d.siteTitle}</a></h1>
      <h2 class="site-subtitle">{d.siteSubtitle}</h2>
    </div>
    <div class="site-header__right">
      <ul class="lang-switch">
        {langs.map((l) => (
          <li class={`lang-switch__item ${l === lang ? 'lang-switch__item--current' : ''}`}>
            {l === lang ? (
              <>
                <i class="fa fa-caret-right lang-switch__caret-m" aria-hidden="true"></i>
                <span>{d.lang[l]}</span>
                <i class="fa fa-caret-up lang-switch__caret-d" aria-hidden="true"></i>
              </>
            ) : (
              <a href={altPath}>{d.lang[l]}</a>
            )}
          </li>
        ))}
      </ul>
      <button type="button" class="nav-toggle" aria-controls="site-nav" aria-expanded="false">
        <i class="fa fa-bars" aria-hidden="true"></i> {d.menu}
      </button>
    </div>
  </div>
  <nav id="site-nav" class="site-nav hidden lg:block">
    <ul class="site-nav__list">
      {items.map((it, i) => (
        <li class={`site-nav__item ${i === 0 ? 'site-nav__item--home' : ''}`}>
          <a
            href={localePath(lang, it.path)}
            aria-current={it.key === nav ? 'page' : undefined}
            class={`site-nav__link ${it.key === nav ? 'site-nav__link--current' : ''}`}
          >
            <i class={`fa ${it.icon} site-nav__icon`} aria-hidden="true"></i>
            <span class="site-nav__text">{d.nav[it.key]}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  // ヘッダーの高さを CSS 変数に反映する (sticky ヘッダーのテーマでアンカー移動先が隠れないようにするため)
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const setHeight = () => document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    setHeight();
    new ResizeObserver(setHeight).observe(header);
  }

  const btn = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.querySelector<HTMLElement>('.site-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
