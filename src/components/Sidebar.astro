---
import { t, localePath, type Lang } from '@/lib/i18n';
import { newsFor, newsTitle, newsSlug } from '@/lib/news';
import { site } from '@/data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const news = (await newsFor(lang)).slice(0, site.topNews);
---

<aside class="sidebar">
  <section>
    <h3 class="sidebar__title">{d.sidebar.news}</h3>
    <ul class="side-list">
      {news.map((n) => (
        <li><a href={localePath(lang, `/news/${newsSlug(n)}/`)}>{newsTitle(n, lang)}</a></li>
      ))}
    </ul>
    <div class="sidebar__more">
      <a href={localePath(lang, '/news/')}><i class="fa fa-angle-double-right" aria-hidden="true"></i> {d.sidebar.newsArchives}</a>
    </div>
  </section>
</aside>
