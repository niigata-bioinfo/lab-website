---
import { t, type Lang } from '@/lib/i18n';
import { site } from '@/data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---

<footer class="site-footer">
  <div class="site-w">
    <p>
      &copy;{site.since} {d.footer.copyright}<br />
      {d.footer.org}
    </p>
  </div>
</footer>
