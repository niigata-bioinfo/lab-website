---
import { t, type Lang } from '../lib/i18n';
import { site } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
---

<footer class="mt-[35px] p-[10px] bg-brand-950 text-white text-[12px] lg:mt-[120px] lg:py-[20px] lg:px-0 lg:text-[13px]">
  <div class="site-w">
    <p>
      &copy;{site.since} {d.footer.copyright}<br />
      {d.footer.org}
    </p>
  </div>
</footer>
