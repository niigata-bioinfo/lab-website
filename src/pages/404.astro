---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageTitle from '../components/PageTitle.astro';
import { t, localePath } from '../lib/i18n';
const ja = t('ja');
const en = t('en');
---

<BaseLayout lang="ja" title="404" nav="home" path="/" hasAlternate={false}>
  <PageTitle>{ja.notFound.title} / {en.notFound.title}</PageTitle>
  <div class="page-content">
    <p>{ja.notFound.body}</p>
    <p>{en.notFound.body}</p>
    <p><a href={localePath("ja", "/")}>{ja.notFound.home}</a> / <a href={localePath("en", "/")}>{en.notFound.home}</a></p>
  </div>
</BaseLayout>
