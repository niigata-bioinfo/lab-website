---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageTitle from '../../../components/PageTitle.astro';
import PubBadge from '../../../components/PubBadge.astro';
import PubLinks from '../../../components/PubLinks.astro';
import { t, localePath, tagLabel, langs, langParam, type Lang } from '../../../lib/i18n';
import { publicationsFor, type Publication } from '../../../lib/publications';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of langs) {
    for (const pub of await publicationsFor(lang)) {
      paths.push({ params: { lang: langParam(lang), id: String(pub.id) }, props: { lang, pub } });
    }
  }
  return paths;
}
const { lang, pub } = Astro.props as { lang: Lang; pub: Publication };
const d = t(lang);
---

<BaseLayout lang={lang} title={pub.title} nav="publications" path={`/publications/${pub.id}/`} hasAlternate={!pub.lang}>
  <div class="page-meta"><PubBadge lang={lang} type={pub.type} /></div>
  <PageTitle variant="pub">{pub.title}</PageTitle>
  <div class="page-content">
    <p>{pub.citation}</p>
    <PubLinks pub={pub} />
    {pub.tags.length > 0 && (
      <ul class="pub-tags">
        {pub.tags.map((tag) => (
          <li>
            <a class="pub-tag" href={localePath(lang, `/publications/tag/${tag}/`)}>{tagLabel(lang, tag)}</a>
          </li>
        ))}
      </ul>
    )}
  </div>
  <div class="page-back">
    <a href={localePath(lang, '/publications/')}><i class="fa fa-angle-double-left" aria-hidden="true"></i> {d.backToList}</a>
  </div>
</BaseLayout>
