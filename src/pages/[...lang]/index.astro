---
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PubBadge from '@/components/PubBadge.astro';
import PubLinks from '@/components/PubLinks.astro';
import { t, localePath, formatDate, withBase, type Lang } from '@/lib/i18n';
import { langPaths } from '@/lib/paths';
import { publicationsFor, publicationUrl } from '@/lib/publications';
import { newsFor, newsTitle, newsSlug } from '@/lib/news';
import { site } from '@/data/site';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const intro = await getEntry('pages', `${lang}/home`);
if (!intro) throw new Error(`src/content/pages/${lang}/home.md がありません`);
const { Content } = await render(intro);
const pubs = (await publicationsFor(lang)).slice(0, site.topPublications);
const news = (await newsFor(lang)).slice(0, site.topNews);
/** 旧サイトの抜粋と同じく 50 語で切り、切った場合はリンクを出さない */
function excerpt(text: string): { text: string; truncated: boolean } {
  const words = text.split(/\s+/);
  if (words.length <= 50) return { text, truncated: false };
  return { text: words.slice(0, 50).join(' ') + ' …', truncated: true };
}
---

<BaseLayout lang={lang} nav="home" path="/" top>
  {d.top.recruitment && (
    <p><a class="special-link" href={localePath(lang, '/recruitment/')}>{d.top.recruitment}</a></p>
  )}

  <section class="top-section">
    <h2 class="page-title">{d.top.about}</h2>
    <div class="top-intro">
      <div class="top-intro__text"><Content /></div>
      <img class="top-intro__img" src={withBase("/images/top_papers.png")} width="300" height="350" alt="" />
    </div>
  </section>

  <section class="top-section">
    <h2 class="page-title">{d.top.latestPublications}</h2>
    <ul class="pub-cards">
      {pubs.map((p) => { const ex = excerpt(p.citation); return (
        <li class="pub-card">
          <div class="pub-card__inner">
            <a class="pub-card__link" href={publicationUrl(lang, p)}>
              <div class="pub-card__text">
                <p>{ex.text}</p>
                {!ex.truncated && <PubLinks pub={p} class="pub-card__links" plain />}
              </div>
            </a>
            <PubBadge lang={lang} type={p.type} class="pub-card__badge" />
          </div>
        </li>
      ); })}
    </ul>
    <div class="more-link">
      <a href={localePath(lang, '/publications/')}><i class="fa fa-angle-double-right" aria-hidden="true"></i> {d.top.publicationsList}</a>
    </div>
  </section>

  <section class="top-section">
    <h2 class="page-title">{d.top.news}</h2>
    <ul class="top-news">
      {news.map((n) => (
        <li>
          <p class="top-news__date">{formatDate(n.data.date)}{d.top.updated}</p>
          <p class="top-news__item"><a href={localePath(lang, `/news/${newsSlug(n)}/`)}>{newsTitle(n, lang)}</a></p>
        </li>
      ))}
    </ul>
    <div class="more-link">
      <a href={localePath(lang, '/news/')}><i class="fa fa-angle-double-right" aria-hidden="true"></i> {d.top.newsList}</a>
    </div>
  </section>
</BaseLayout>
