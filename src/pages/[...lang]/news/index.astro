---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageTitle from '../../../components/PageTitle.astro';
import { t, localePath, formatDate, type Lang } from '../../../lib/i18n';
import { langPaths } from '../../../lib/paths';
import { newsFor, newsTitle, newsSlug } from '../../../lib/news';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const d = t(lang);
const news = await newsFor(lang);
const rendered = await Promise.all(news.map(async (n) => ({ n, Content: (await render(n)).Content })));
---

<BaseLayout lang={lang} title={d.news.title} nav="news" path="/news/">
  <PageTitle>{d.news.title}</PageTitle>
  {rendered.length === 0 ? (
    <p class="my-[30px] mx-[20px] text-[16px]">{d.news.empty}</p>
  ) : (
    <ul class="archive-list">
      {rendered.map(({ n, Content }) => (
        <li>
          <div class="archive-meta"><p class="archive-date inline-block align-middle">{formatDate(n.data.date)}</p></div>
          <p class="archive-title"><a href={localePath(lang, `/news/${newsSlug(n)}/`)}>{newsTitle(n, lang)}</a></p>
          <div class="archive-text"><Content /></div>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>
