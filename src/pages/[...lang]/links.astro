---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageTitle from '../../components/PageTitle.astro';
import { langPaths } from '../../lib/paths';
import type { Lang } from '../../lib/i18n';

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const page = await getEntry('pages', `${lang}/links`);
if (!page) throw new Error(`src/content/pages/${lang}/links.md がありません`);
const { Content } = await render(page);
---

<BaseLayout lang={lang} title={page.data.title} nav="links" path="/links/">
  <PageTitle>{page.data.title}</PageTitle>
  <div class="page-content"><Content /></div>
</BaseLayout>
